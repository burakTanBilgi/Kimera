{
  "_note": "An example with made-up users and hosts. Copy it to ~/.config/kimera/devices.json and fill in your own. One row per device; a new device is one more row. Values are paths and limits, never secrets.",
  "caretta": {
    "ssh": ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "USER@HOST"],
    "chat": true,
    "seat_roots": ["/home/USER/seats"],
    "seed_roots": ["~/work/worktrees"],
    "config_dir": "/home/USER/.claude",
    "claude": "/home/USER/.local/bin/claude",
    "hook_port": 8732,
    "hook_token_file": "/home/USER/.config/kimera/hook-token",
    "limits": {"avail_mb": 1500, "disk_gb": 3, "max_chats": 1},
    "mirror_dir": "~/.local/share/kimera/mirror/caretta/claude/projects"
  },
  "kirpi": {
    "ssh": ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "USER@HOST"],
    "chat": true,
    "why_not": "Kirpi takes one read-only chat (plan mode, a 500 MB box) when 650 MB is free; the local model keeps the rest.",
    "seat_roots": ["/home/USER/seats"],
    "seed_roots": ["~/work/worktrees"],
    "config_dir": "/home/USER/.claude",
    "claude": "/home/USER/.local/bin/claude",
    "hook_port": 8732,
    "hook_token_file": "/home/USER/.config/kimera/hook-token",
    "limits": {"avail_mb": 650, "disk_gb": 3, "max_chats": 1},
    "mirror_dir": "~/.local/share/kimera/mirror/kirpi/claude/projects",
    "modes": ["plan"],
    "box_mb": 500,
    "tmux": true,
    "node": true,
    "rsync": true,
    "tools_force": "Read,Grep,Glob"
  }
}
