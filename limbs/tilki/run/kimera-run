#!/usr/bin/env python3
"""kimera-run DEVICE VERB [ARGS]: the one door AIDEN uses to run a chat on a device. No shell string, no free text.
  admit
  start  NAME CWD SID [MODE] [MODEL] [TOOLS]
  resume NAME CWD SID [MODE] [MODEL] [TOOLS]
  sample          one JSON line of the device's memory, load, swap, temperature and each chat's resident memory
  has NAME | capture NAME [ansi] | type NAME   (text on stdin, up to 64 KiB) | key NAME KEY | kill NAME | facts NAME
Exit codes: 0 ok/yes   1 no/failed   2 refused (one sentence on stdout)   3 device away   4 bad arguments
Each verb goes over ssh. With `run.authorized` the key can run only the device's `kimera-seat` (restrict + forced
command); before that it uses the device user's own login to call the same script, with the same checks.
The device checks the same shapes again, applies its own admission and writes its audit line (~/kimera/run.log).
Rows: ~/.config/kimera/devices.json (`ssh` as before, `run`: {"key": path, "authorized": bool}); an example is in limbs/tilki/device/devices.example.json.
"""
import json, os, re, subprocess, sys, time

CONF = os.environ.get('KIMERA_DEVICES', os.path.expanduser('~/.config/kimera/devices.json'))
AWAY_LOG = os.path.expanduser('~/.local/state/kimera/run-away.log')
NAME_RE = re.compile(r'^aiden-[a-z0-9-]{8,36}$')
SID_RE = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
PATH_RE = re.compile(r'^/[A-Za-z0-9_./-]+$')
MODES = ('plan', 'acceptEdits', 'auto')
MODELS = ('sonnet', 'opus', 'haiku')
TOOLSETS = ('Read,Grep,Glob,Bash,Edit,Write', 'Read,Grep,Glob,Bash')
KEYS = ('Enter', 'C-u', 'Escape', 'C-c')
MAX_TYPE = 64 * 1024


def bad(why):
    print(why)
    sys.exit(4)


def check(verb, args):
    if verb in ('admit', 'sample'):
        return len(args) == 0 or bad('%s takes no arguments' % verb)
    if verb in ('start', 'resume'):
        if len(args) < 3 or len(args) > 6:
            bad('%s needs NAME CWD SID [MODE] [MODEL] [TOOLS]' % verb)
        if not NAME_RE.fullmatch(args[0]): bad('NAME must be aiden- plus 8 to 36 of a-z, 0-9, -')
        if not PATH_RE.fullmatch(args[1]) or '..' in args[1].split('/'): bad('CWD must be an absolute path of a-z, 0-9, _ . / -')
        if not SID_RE.fullmatch(args[2]): bad('SID must be a UUID')
        for v in args[3:]:
            if v not in MODES + MODELS + TOOLSETS: bad('unknown option value')
        return
    if verb in ('has', 'capture', 'type', 'key', 'kill', 'facts'):
        if not args or not NAME_RE.fullmatch(args[0]): bad('NAME must be aiden- plus 8 to 36 of a-z, 0-9, -')
        extra = args[1:]
        if verb == 'capture' and extra not in ([], ['ansi']): bad('capture takes NAME and optionally ansi')
        if verb == 'key' and (len(extra) != 1 or extra[0] not in KEYS): bad('KEY must be one of ' + ' '.join(KEYS))
        if verb not in ('capture', 'key') and extra: bad('%s takes only NAME' % verb)
        return
    bad('unknown verb; use admit start resume has capture type key kill facts')


def main():
    a = sys.argv[1:]
    if len(a) < 2:
        print(__doc__)
        return 4
    dev, verb, args = a[0], a[1], a[2:]
    try:
        rows = json.load(open(CONF))
    except Exception as e:
        print('cannot read devices.json: %s' % e)
        return 4
    row = rows.get(dev) if isinstance(rows, dict) and not dev.startswith('_') else None
    if not row:
        print('no such device')
        return 4
    check(verb, args)
    if verb in ('start', 'resume', 'admit') and not row.get('chat'):
        print(row.get('why_not', 'this device does not take chats'))
        return 2
    run = row.get('run') or {}
    data = b''
    if verb == 'type':
        data = sys.stdin.buffer.read(MAX_TYPE + 1)
        if len(data) > MAX_TYPE:
            print('text is over 64 KiB')
            return 2
        if not data:
            bad('type needs text on stdin')
    ssh = row['ssh']
    if run.get('authorized'):
        # the narrow key: the device runs only kimera-seat, whatever is asked
        cmd = ssh[:-1] + ['-i', os.path.expanduser(run['key']), '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes',
                          '-o', 'ConnectTimeout=8', ssh[-1], ' '.join([verb] + args)]
    else:
        # not yet authorized: the device user's own login, same script, values already checked to a safe shape
        cmd = ssh + ["SSH_ORIGINAL_COMMAND='%s' ~/kimera/bin/kimera-seat" % ' '.join([verb] + args)]
    try:
        r = subprocess.run(cmd, input=data, capture_output=True, timeout=60 if verb in ('start', 'resume') else 30)
    except subprocess.TimeoutExpired:
        r = None
    if r is None or r.returncode == 255:
        try:
            os.makedirs(os.path.dirname(AWAY_LOG), exist_ok=True)
            with open(AWAY_LOG, 'a') as f:
                f.write('%s %s %s away\n' % (time.strftime('%Y-%m-%dT%H:%M:%S%z'), dev, verb))
        except OSError:
            pass
        print('device away')
        return 3
    sys.stdout.buffer.write(r.stdout)
    return r.returncode if r.returncode in (0, 1, 2, 4) else 1


if __name__ == '__main__':
    sys.exit(main())
