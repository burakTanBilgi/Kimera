#!/usr/bin/env python3
"""kimera-run DEVICE VERB [ARGS]: the one door AIDEN uses to run a chat on a device. No shell string, no free text.
  admit
  start  NAME CWD SID [MODE] [MODEL] [TOOLS]
  resume NAME CWD SID [MODE] [MODEL] [TOOLS]
  seed CWD SRC [PACK]
                  put a read copy of the work in SRC (a git worktree on this machine, tracked files at HEAD only)
                  into the seat folder CWD on the device, replacing what was there. Answers `ok FILES BYTES COMMIT`.
                  PACK: a plain folder of text files on this machine (a chat's memory), laid read-only at
                  CWD/.memory/ in the same seed, so the chat has it and `fetch` never reports it
  fetch CWD       what a chat changed in a seeded folder, as one text diff on stdout (2 MB at most); exit 1 and
                  `no changes` when there is none. A link or a binary file is refused by name
  pull CWD FILE   bring one finished file (a built program, say) from a seat folder to this machine. It is kept,
                  never run: ~/.local/share/kimera/pulled/DEVICE/<first 16 of its sha256>-<name>, mode 600.
                  Answers `ok PATH BYTES SHA256`. 64 MB a file at most
  ask NAME MODEL  one short question to a cloud model on the device, no chat and no tools: stdin is one JSON object
                  {"system": text, "prompt": text} (128 KiB at most), stdout is the model's text. For a row with `ask`.
                  One at a time; exit 2 with one sentence when the device has no room, 3 when it is away
  sample          one JSON line of the device's memory, load, swap, temperature and each chat's resident memory
  has NAME | capture NAME [ansi] | type NAME   (text on stdin, up to 64 KiB) | key NAME KEY | kill NAME | facts NAME
Exit codes: 0 ok/yes   1 no/failed   2 refused (one sentence on stdout)   3 device away   4 bad arguments
Each verb goes over ssh. With `run.authorized` the key can run only the device's `kimera-seat` (restrict + forced
command); before that it uses the device user's own login to call the same script, with the same checks.
The device checks the same shapes again, applies its own admission and writes its audit line (~/kimera/run.log).
Rows: ~/.config/kimera/devices.json (`ssh` as before, `run`: {"key": path, "authorized": bool}); an example is in limbs/tilki/device/devices.example.json.
"""
import hashlib, io, json, os, re, shutil, stat, subprocess, sys, tarfile, tempfile, threading, time

CONF = os.environ.get('KIMERA_DEVICES', os.path.expanduser('~/.config/kimera/devices.json'))
AWAY_LOG = os.path.expanduser('~/.local/state/kimera/run-away.log')
NAME_RE = re.compile(r'^aiden-[a-z0-9-]{8,36}$')
SID_RE = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
PATH_RE = re.compile(r'^/[A-Za-z0-9_./-]+$')
REL_RE = re.compile(r'^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$')
MAX_PULL, MAX_PULLED = 64 << 20, 1 << 30
MODES = ('plan', 'acceptEdits', 'auto')
MODELS = ('sonnet', 'opus', 'haiku')
TOOLSETS = ('Read,Grep,Glob,Bash,Edit,Write', 'Read,Grep,Glob,Bash')
KEYS = ('Enter', 'C-u', 'Escape', 'C-c')
MAX_TYPE = 64 * 1024
MAX_ASK = 128 * 1024


def bad(why):
    print(why)
    sys.exit(4)


def check(verb, args):
    if verb in ('admit', 'sample'):
        return len(args) == 0 or bad('%s takes no arguments' % verb)
    if verb in ('start', 'resume'):
        if len(args) < 3 or len(args) > 6:
            bad('%s needs NAME CWD SID [MODE] [MODEL] [TOOLS]' % verb)
        if not NAME_RE.fullmatch(args[0]): bad('NAME must be aiden- plus 8 to 36 of a-z, 0-9, -')
        if not PATH_RE.fullmatch(args[1]) or '..' in args[1].split('/'): bad('CWD must be an absolute path of a-z, 0-9, _ . / -')
        if not SID_RE.fullmatch(args[2]): bad('SID must be a UUID')
        for v in args[3:]:
            if v not in MODES + MODELS + TOOLSETS: bad('unknown option value')
        return
    if verb == 'ask':
        if len(args) != 2 or not re.fullmatch(r'[a-z][a-z0-9-]{0,23}', args[0]) or args[1] not in MODELS: bad('ask needs NAME (a-z, 0-9, -; up to 24) and MODEL')
        return
    if verb == 'pull':
        if len(args) != 2 or not PATH_RE.fullmatch(args[0]) or '..' in args[0].split('/'): bad('pull needs CWD FILE; CWD an absolute path of a-z, 0-9, _ . / -')
        if not REL_RE.fullmatch(args[1]) or len(args[1]) > 400: bad('FILE must be a path inside the folder, of a-z, 0-9, _ . - and /, with no step upward')
        return
    if verb == 'fetch':
        if len(args) != 1 or not PATH_RE.fullmatch(args[0]) or '..' in args[0].split('/'): bad('fetch needs CWD, an absolute path of a-z, 0-9, _ . / -')
        return
    if verb == 'seed':
        if len(args) not in (2, 3): bad('seed needs CWD SRC [PACK]')
        for v, what in zip(args, ('CWD', 'SRC', 'PACK')):
            if not PATH_RE.fullmatch(v) or '..' in v.split('/'): bad('%s must be an absolute path of a-z, 0-9, _ . / -' % what)
        return
    if verb in ('has', 'capture', 'type', 'key', 'kill', 'facts'):
        if not args or not NAME_RE.fullmatch(args[0]): bad('NAME must be aiden- plus 8 to 36 of a-z, 0-9, -')
        extra = args[1:]
        if verb == 'capture' and extra not in ([], ['ansi']): bad('capture takes NAME and optionally ansi')
        if verb == 'key' and (len(extra) != 1 or extra[0] not in KEYS): bad('KEY must be one of ' + ' '.join(KEYS))
        if verb not in ('capture', 'key') and extra: bad('%s takes only NAME' % verb)
        return
    bad('unknown verb; use admit start resume seed fetch pull ask has capture type key kill facts sample')


def pull(dev, cmd, args):
    """Keep one file a device sends. The device is not trusted: the bytes go to disk as they come, never past the
    limit, the name is the last part of the path already checked for shape, and the file is stored unrunnable under
    a name that starts with its own sha256. Nothing here ever runs it."""
    store = os.path.join(os.path.expanduser('~/.local/share/kimera/pulled'), dev)
    os.makedirs(store, mode=0o700, exist_ok=True)
    held = sum(e.stat(follow_symlinks=False).st_size for e in os.scandir(os.path.dirname(store) + '/' + dev) if e.is_file(follow_symlinks=False))
    if held + MAX_PULL > MAX_PULLED:
        print('the store of pulled files for this device is full (1 GB); remove what is no longer needed')
        return 2
    tmp = tempfile.NamedTemporaryFile(dir=store, prefix='.incoming-', delete=False)
    digest, got, p = hashlib.sha256(), 0, None
    try:
        os.chmod(tmp.name, 0o600)
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        late = threading.Timer(180, p.kill)
        late.start()
        while True:
            chunk = p.stdout.read(1 << 20)
            if not chunk:
                break
            got += len(chunk)
            if got > MAX_PULL:
                p.kill()
                break
            digest.update(chunk)
            tmp.write(chunk)
        rc = p.wait()
        hung = not late.is_alive()
        late.cancel()
        tmp.close()
        if hung or rc == 255:
            print('device away')
            return 3
        if got > MAX_PULL:
            print('the device sent more than 64 MB; nothing is kept')
            return 2
        if rc != 0:  # a refusal: what came is the device's one sentence, not a file
            words = open(tmp.name, 'rb').read(400).decode('utf-8', 'replace')
            print(''.join(ch if ch.isprintable() else '?' for ch in words.strip())[:300])
            return rc if rc in (1, 2, 4) else 1
        sha = digest.hexdigest()
        dest = os.path.join(store, '%s-%s' % (sha[:16], os.path.basename(args[1])[:100]))
        os.replace(tmp.name, dest)
        try:
            with open(os.path.expanduser('~/.local/state/kimera/pulled.log'), 'a') as f:
                f.write('%s %s %s %d %s\n' % (time.strftime('%Y-%m-%dT%H:%M:%S%z'), dev, args[1], got, sha))
        except OSError:
            pass
        print('ok %s %d %s' % (dest, got, sha))
        return 0
    finally:
        if p and p.poll() is None:
            p.kill()
        try:
            os.remove(tmp.name)
        except OSError:
            pass


MAX_PACK, MAX_PACK_FILES = 20 << 20, 2000


def pack_tar(path, row):
    """(a temp file holding a tar of the pack under .memory/, None) or (None, one sentence). The pack is a chat's
    memory: plain text files only, no links, bounded, and only from a folder this device's row allows."""
    src = os.path.normpath(path)
    roots = [os.path.realpath(os.path.expanduser(r)) for r in row.get('pack_roots', [])]
    root = next((r for r in roots if src.startswith(r + '/')), None)
    if root is None:
        return None, 'that pack is not a folder under a pack root of this device'
    out = tempfile.TemporaryFile()
    total = n = 0
    # Walked by folder handle, never by path: every folder and file is opened inside the handle of its parent without
    # following a link, so swapping any part of the path for a link while we read cannot lead us out of the pack.
    # The same from the pack root down to the pack: one step at a time, each inside the handle of the one before.
    try:
        top = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
        for part in os.path.relpath(src, root).split('/'):
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=top)
            os.close(top)
            top = nxt
    except OSError:
        return None, 'that pack is not a folder under a pack root of this device'
    try:
        with tarfile.open(fileobj=out, mode='w') as t:
            for d, dirs, files, dfd in os.fwalk('.', dir_fd=top, follow_symlinks=False):
                dirs.sort()
                for f in sorted(files):
                    try:
                        fd = os.open(f, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
                    except OSError:
                        return None, 'the pack holds something that is not a plain file'
                    with os.fdopen(fd, 'rb') as fh:
                        st = os.fstat(fh.fileno())
                        if not stat.S_ISREG(st.st_mode):
                            return None, 'the pack holds something that is not a plain file'
                        n, total = n + 1, total + st.st_size
                        if n > MAX_PACK_FILES or total > MAX_PACK:
                            return None, 'the pack is over 2000 files or 20 MB'
                        body = fh.read(MAX_PACK + 1)
                    if len(body) > MAX_PACK:
                        return None, 'the pack is over 2000 files or 20 MB'
                    try:
                        if b'\0' in body:
                            raise ValueError
                        body.decode('utf-8')
                    except ValueError:
                        return None, 'the pack holds a file that is not plain text'
                    i = tarfile.TarInfo('.memory/' + os.path.normpath(os.path.join(d, f)))
                    i.size, i.mode, i.mtime = len(body), 0o444, int(st.st_mtime)
                    t.addfile(i, io.BytesIO(body))
                if any(stat.S_ISLNK(os.stat(x, dir_fd=dfd, follow_symlinks=False).st_mode) for x in dirs):
                    return None, 'the pack holds something that is not a plain file'
    except OSError:
        return None, 'the pack could not be read'
    finally:
        os.close(top)
    out.seek(0)
    return out, None


def main():
    a = sys.argv[1:]
    if len(a) < 2:
        print(__doc__)
        return 4
    dev, verb, args = a[0], a[1], a[2:]
    try:
        rows = json.load(open(CONF))
    except Exception as e:
        print('cannot read devices.json: %s' % e)
        return 4
    row = rows.get(dev) if isinstance(rows, dict) and not dev.startswith('_') else None
    if not row:
        print('no such device')
        return 4
    check(verb, args)
    if verb in ('start', 'resume', 'admit', 'seed', 'fetch', 'pull') and not row.get('chat'):
        print(row.get('why_not', 'this device does not take chats'))
        return 2
    run = row.get('run') or {}
    data = b''
    if verb == 'type':
        data = sys.stdin.buffer.read(MAX_TYPE + 1)
        if len(data) > MAX_TYPE:
            print('text is over 64 KiB')
            return 2
        if not data:
            bad('type needs text on stdin')
    if verb == 'ask':
        if not row.get('ask'):
            print('this device does not take asks')
            return 2
        data = sys.stdin.buffer.read(MAX_ASK + 1)
        if len(data) > MAX_ASK:
            print('the question is over 128 KiB')
            return 2
    ssh = row['ssh']
    feed = None
    if verb == 'seed':
        # only work under a root this device's row allows, and only what git tracks at HEAD: an untracked file
        # (a key, a .env, a build folder) never travels
        src = os.path.realpath(args[1])
        roots = [os.path.realpath(os.path.expanduser(r)) for r in row.get('seed_roots', [])]
        if not any(src.startswith(r + '/') for r in roots):
            print('that folder is not under a seed root of this device')
            return 2
        git = ['git', '-C', src, '-c', 'core.fsmonitor=false']
        try:
            top = subprocess.run(git + ['rev-parse', '--show-toplevel'], capture_output=True, text=True, timeout=20)
            head = subprocess.run(git + ['rev-parse', '--verify', 'HEAD^{commit}'], capture_output=True, text=True, timeout=20)
        except subprocess.TimeoutExpired:
            top = head = None
        commit = head.stdout.strip() if head and head.returncode == 0 else ''
        if not top or top.returncode != 0 or os.path.realpath(top.stdout.strip()) != src or not re.fullmatch(r'[0-9a-f]{40}', commit):
            print('that folder is not the top of a git worktree with a commit')
            return 2
        # .memory/ is where a chat is told its owner's memory lies. Work that carries its own folder of that name would
        # be read as memory, so it is refused: only a pack this program lays may be there.
        # (any spelling of the name: a folder .Memory is one a reader would take for it too)
        own = subprocess.run(git + ['ls-tree', '--name-only', '-z', commit], capture_output=True, timeout=30)
        if own.returncode != 0 or any(x.decode('utf-8', 'replace').lower() in ('.memory', '.memory-proposals') for x in own.stdout.split(b'\0')):
            print('the work itself holds a .memory folder; that name is kept for the memory pack')
            return 2
        pack = None
        if len(args) == 3:
            pack, why = pack_tar(args[2], row)
            if pack is None:
                print(why)
                return 2
        feed = subprocess.Popen(git + ['archive', '--format=tar', commit], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        args = [args[0], commit]
    if run.get('authorized'):
        # the narrow key: the device runs only kimera-seat, whatever is asked
        cmd = ssh[:-1] + ['-i', os.path.expanduser(run['key']), '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes',
                          '-o', 'ConnectTimeout=8', ssh[-1], ' '.join([verb] + args)]
    else:
        # not yet authorized: the device user's own login, same script, values already checked to a safe shape
        cmd = ssh + ["SSH_ORIGINAL_COMMAND='%s' ~/kimera/bin/kimera-seat" % ' '.join([verb] + args)]
    if verb == 'pull':
        return pull(dev, cmd, args)
    try:
        if feed:  # the work streams from git to the device; it is never held whole in this machine's memory
            if pack is None:
                r = subprocess.run(cmd, stdin=feed.stdout, capture_output=True, timeout=180)
            else:  # the work, then the pack, down one pipe
                p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

                def pump():
                    try:
                        shutil.copyfileobj(feed.stdout, p.stdin)
                        shutil.copyfileobj(pack, p.stdin)
                        p.stdin.close()
                    except OSError:
                        pass
                t = threading.Thread(target=pump, daemon=True)
                t.start()
                late = threading.Timer(180, p.kill)  # the read below would wait for ever on a device that hangs
                late.start()
                out = p.stdout.read(1 << 20)
                p.wait()
                hung = not late.is_alive()
                late.cancel()
                if hung:
                    raise subprocess.TimeoutExpired(cmd, 180)
                r = subprocess.CompletedProcess(cmd, p.returncode, out, b'')
            feed.stdout.close()
            if feed.wait(timeout=10) != 0 and r.returncode == 0:
                print('git could not pack the work')
                return 1
        else:
            r = subprocess.run(cmd, input=data, capture_output=True, timeout=60 if verb in ('start', 'resume', 'fetch') else 360 if verb == 'ask' else 30)
    except subprocess.TimeoutExpired:
        r = None
        if feed:
            feed.kill()
    if r is None or r.returncode == 255:
        try:
            os.makedirs(os.path.dirname(AWAY_LOG), exist_ok=True)
            with open(AWAY_LOG, 'a') as f:
                f.write('%s %s %s away\n' % (time.strftime('%Y-%m-%dT%H:%M:%S%z'), dev, verb))
        except OSError:
            pass
        print('device away')
        return 3
    sys.stdout.buffer.write(r.stdout)
    return r.returncode if r.returncode in (0, 1, 2, 4) else 1


if __name__ == '__main__':
    sys.exit(main())
